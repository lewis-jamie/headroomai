# Example environment variables for Headroom provider configuration

# General Headroom
ANTHROPIC_API_KEY=sk-ant-dummy
HEADROOM_BACKEND=litellm-ollama
HEADROOM_HOST=127.0.0.1
HEADROOM_PORT=8787

# Ollama
OLLAMA_API_KEY=
OLLAMA_HOST=http://localhost:11434

# vLLM / Llama HTTP endpoints (if used)
VLLM_HOST=http://localhost:8080
VLLM_API_KEY=
LLAMA_HOST=http://localhost:8081
LLAMA_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Vertex
GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

